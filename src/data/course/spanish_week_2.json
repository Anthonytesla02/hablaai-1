      "day": 8,
      "title": "Where Things Are",
      "focus": "estar, hay, and locations",
      "estimated_minutes": 20,
      "objectives": [
        "say where a person or object is",
        "distinguish hay from está/están",
        "use en, aquí, and allí"
      ],
      "teaching": {
        "explanation": "Use hay for “there is/there are” when introducing existence. Use está or están for the location of a known singular or plural item.",
        "pattern": "Hay un libro en la mesa. = There is a book on the table. El libro está en la mesa. = The book is on the table.",
        "contrast": "Hay introduces; está/están locates."
      },
