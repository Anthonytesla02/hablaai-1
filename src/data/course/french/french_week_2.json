      "id": "fr-w2-d08",
      "day": 8,
      "title": "Where Things Are",
      "focus": "être, il y a, and locations",
      "estimated_minutes": 20,
      "objectives": [
        "say where a person or object is",
        "distinguish il y a from est/sont",
        "use en, ici, and là"
      ],
      "teaching": {
        "explanation": "Use il y a for “there is/there are” when introducing existence. Use est or sont (forms of être) for the location of a known singular or plural item.",
        "pattern": "Il y a un livre sur la table. = There is a book on the table. Le livre est sur la table. = The book is on the table.",
        "contrast": "Il y a introduces existence; est/sont locates."
      },
